#!/bin/sh
# Runs tt.py from the directory of this script, on Linux and macOS
directory=$(dirname "$0")
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$directory/tt.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$directory/tt.py" "$@"
fi
echo "tt: Python 3 not found" >&2
exit 1
